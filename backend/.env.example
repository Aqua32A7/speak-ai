# Gemini API Key (Required for live Gemini calls)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Sensible default: gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# CORS Allowed Origins (comma-separated, Vite dev and preview servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
